<Window x:Class="WPF_MVVM_Kurse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_MVVM_Kurse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- wir teilen die Zeichnungsfläche ein -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>


        <!-- eine ListView für die Anzeige der Kurse -->
        <!-- ItemSource legt die Datenquelle fest : aus unserem ViewModel ist Liste -->
        <!-- SelectedItem ist der  ausgewählte Kurs in dem ListView, wird im Modell an die Variable Wahl gebunden-->
        <ListView x:Name="viewAnzeige" ItemsSource="{Binding Liste}" Grid.Column="0" SelectedItem="{Binding Wahl}">
            <!-- wir erstellen eine Vorlage für die Anzeige eines Kurses -->
            <ListView.ItemTemplate>
                <!-- die anzuzeigenden Daten kommen aus Objekten -->
                <DataTemplate>
                    <!-- wir legen ein Layout fest für die Anzeige -->
                    <!-- StackPanal ist eine Einteilung für die Anzeige eines Kurses -->
                    <Grid Margin="0,20,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <!-- wir legen fest welche Eigenschaft vom Kurs angezeigt werden soll -->
                        <Label Grid.Column="0" Grid.Row="0" Content="Titel" />
                        <Label Grid.Column="1" Grid.Row="0" Content="{Binding Titel}" />
                        <Label Grid.Column="0" Grid.Row="1" Content="Kategorie" />
                        <Label Grid.Column="1" Grid.Row="1" Content="{Binding Kategorie}"/>
                        <Label Grid.Column="0" Grid.Row="2" Content="Preis" />
                        <Label Grid.Column="1" Grid.Row="2" Content="{Binding Preis}" />
                        <Label Grid.Column="0" Grid.Row="3" Content="Dozent" />
                        <Label Grid.Column="1" Grid.Row="3" Content="{Binding Dozent.Nachname}" />
                        
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- rechte Seite im Fenster festlegen -->
        <StackPanel Grid.Column="1" Margin="20,20,20,20">
            <Label Content="Titel" />
            <!-- der anzuzeigende Text ist der Titel von dem gewählten Eintrag aus dem ListView -->
            <TextBox x:Name="txtTitel" Text="{Binding Wahl.Titel}" KeyUp="txtTitel_KeyUp"/>

            <Label Content="Kategorie" />
            <!-- Kategorie wird aus einer Menge ausgewählt -->
            <!-- ItemsSource: die Auswahlmöglichkeiten aus dem ViewModel -->
            <!-- SelectedItem: die aktuell gewählte Kategorie des Kurses -->
            <ComboBox x:Name="cmbKategorie" ItemsSource="{Binding Kategorien}" SelectedItem="{Binding Wahl.Kategorie}"/>

            <Label Content="Dozent" />
            <ComboBox x:Name="cmbDozentenliste" ItemsSource="{Binding Dozentenliste}" SelectedItem="{Binding Wahl.Dozent}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Nachname}" />
                            <TextBlock Text=", " />
                            <TextBlock Text="{Binding Vorname}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="Preis" />
            <TextBox x:Name="txtPreis" Text="{Binding Wahl.Preis}" KeyUp="txtPreis_KeyUp"/>

            <Button x:Name="btnDelete" Content="Löschen" Click="btnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>